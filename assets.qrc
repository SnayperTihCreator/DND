<RCC>
    <qresource prefix="icons">
        <file alias="main.png">resource/icon.png</file>
    </qresource>
    <qresource prefix="icons/cls">
        <file alias="bard.png">resource/classes/bard.png</file>
        <file alias="barbarian.png">resource/classes/barbarian.png</file>
        <file alias="fighter.png">resource/classes/fighter.png</file>
        <file alias="wizard.png">resource/classes/wizard.png</file>
        <file alias="druid.png">resource/classes/druid.png</file>
        <file alias="cleric.png">resource/classes/cleric.png</file>
        <file alias="artificer.png">resource/classes/artificer.png</file>
        <file alias="warlock.png">resource/classes/warlock.png</file>
        <file alias="monk.png">resource/classes/monk.png</file>
        <file alias="paladin.png">resource/classes/paladin.png</file>
        <file alias="rogue.png">resource/classes/rogue.png</file>
        <file alias="ranger.png">resource/classes/ranger.png</file>
        <file alias="sorcerer.png">resource/classes/sorcerer.png</file>
    </qresource>
    <qresource prefix="icons/token">
        <file alias="hp.png">resource/icons/hp.png</file>
        <file alias="kd.png">resource/icons/kd.png</file>
    </qresource>
    <qresource prefix="css">
        <file alias="tooltip.css">resource/css/tooltip.css</file>
    </qresource>
    <qresource prefix="textures">
        <file alias="fog.png">resource/fog.png</file>
        <file alias="help_size.png">resource/help_size.png</file>
        <file alias="border_token.png">resource/border_token.png</file>
    </qresource>
</RCC>